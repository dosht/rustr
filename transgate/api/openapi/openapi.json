    "securitySchemes": {
      "apiKey": {
        "description": "An API key: `sk_` followed by 44 characters.",
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "bearerFormat": "JWT",
        "description": "The signed-in dashboard session.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Start transcriptions and read their results with an API key, and manage keys from the dashboard. Every key request is limited to 60 per minute and 1000 per hour; the answer carries `X-RateLimit-*` headers. Callbacks to a job's `callbackUrl` are POSTed as JSON with `Transgate-Delivery-Id` (stable across retries; use it to deduplicate) and `Transgate-Signature: t=<unix seconds>,v1=<hex HMAC-SHA256(secret, \"<t>.\" + body)>`.",
    "title": "Transgate API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/callbacks/{id}/replay": {
      "post": {
        "description": "Administrators only. A delivered, failed or abandoned delivery becomes due again under the same delivery id; the next dispatch appends one attempt. A delivery that is still pending is `400`.",
        "operationId": "replayCallback",
        "parameters": [
          {
            "description": "The delivery id (the `Transgate-Delivery-Id` header receivers saw).",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplayResponse"
                }
              }
            },
            "description": "The delivery was reopened."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The request is invalid."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing, malformed, unknown, inactive or expired credentials."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The credentials lack the required scope or permission."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not found, or not yours."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A required store is unavailable. Retry later."
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Replay a callback delivery",
        "x-codeSamples": [
          {
            "label": "curl",
            "lang": "Shell",
            "source": "curl -X POST https://transgate.ai/api/admin/callbacks/$DELIVERY_ID/replay -H 'Authorization: Bearer $ADMIN_SESSION_TOKEN'"
          }
        ]
      }
    },
