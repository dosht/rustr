    "/api/v1/transcriptions": {
      "get": {
        "description": "The status of one of your jobs, with its lines and general summary once it is completed. Needs the `transcriptions:read` scope. A job that is not yours is `404`.",
        "operationId": "getTranscription",
        "parameters": [
          {
            "description": "The job id returned when it was started.",
            "in": "query",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
