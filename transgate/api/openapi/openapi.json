              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The account is being deleted."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A required store is unavailable. Retry later."
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Create an API key",
        "x-codeSamples": [
          {
            "label": "curl",
            "lang": "Shell",
            "source": "curl -X POST https://transgate.ai/api/keys -H 'Authorization: Bearer $SESSION_TOKEN' -H 'Content-Type: application/json' -d '{\"name\":\"CI\",\"scopes\":[\"transcriptions:read\"],\"expirationPolicy\":\"never\"}'"
