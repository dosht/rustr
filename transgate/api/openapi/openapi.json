                }
              }
            },
            "description": "The key and its plaintext value."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The request is invalid."
          },
          "401": {
