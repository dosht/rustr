          },
          "expirationPolicy": {
            "$ref": "#/components/schemas/ExpirationPolicyView"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "hint": {
            "description": "The first characters of the key, for recognising it in a list.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt",
          "isActive",
          "scopes",
          "expirationPolicy"
        ],
        "type": "object"
      },
      "AudioUrlRequest": {
        "properties": {
          "audioUrl": {
            "description": "An absolute `http` or `https` URL of the audio.",
            "type": "string"
          },
          "callbackUrl": {
            "description": "Receives a signed POST with the result when the job completes.",
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "description": "A language name such as `English`; English when absent.",
            "type": [
              "string",
              "null"
            ]
          }
        },
