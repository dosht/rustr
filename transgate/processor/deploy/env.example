# Copy to .env in this directory. Names only; no secrets are needed.

# Image tag.
TAG=dev

# Public hostname Caddy answers on and requests a certificate for.
PROCESSOR_DOMAIN=freetools.example.test

# Comma-separated origins that serve the tool pages (CORS). The code default
# is only https://transgate.ai.
ALLOWED_ORIGINS=https://transgate.ai,https://www.transgate.ai

# FFmpeg decoder/encoder threads; 1 unless the host has room.
FFMPEG_THREADS=1
